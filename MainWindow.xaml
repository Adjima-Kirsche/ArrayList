<Window x:Class="ArrayList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArrayList Manager" Height="360" Width="520"
        Background="#F3F4F6" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="115"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Margin="30" Padding="25">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="กรอกตัวเลขที่ต้องการเพิ่ม หรือ ลบออกจากรายการ" 
                       FontSize="13" Foreground="#64748B" 
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>

            <TextBox x:Name="txtNumber" Height="45" Width="375" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Add" Background="#10B981" Margin="0,0,15,0" Click="BtnAdd_Click"/>
                <Button Content="Remove" Background="#EF4444" Margin="0,0,15,0" Click="BtnRemove_Click"/>
                <Button Content="Showall" Background="#3B82F6" Click="BtnShowAll_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>